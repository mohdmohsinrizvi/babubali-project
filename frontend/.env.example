# Base URL for API requests.
# Defaults to /api when unset, which the Vite dev server proxies to http://localhost:8080.
# Can also be set to an absolute URL, e.g. http://localhost:8080/api
VITE_API_BASE_URL=/api

# NOTE: the dev-server proxy target is hard-coded to http://localhost:8080 in
# vite.config.ts. If you change SERVER_PORT on the backend, update it there too.
# This file is read by Vite; copy it to .env or .env.local to override.
