# SmartBuild backend environment variables.
# Mirror of the backend section of ../.env.example — keep the two files in sync.
# Copy to `.env` (or export in your shell) and fill in real values.
# Never commit a real .env file.
#
# Spring Boot does NOT read `.env` files automatically. Export these in the shell
# before `mvn spring-boot:run`, or see docs/setup.md for the PowerShell recipe.

# PostgreSQL connection (database name: smartbuild_db)
DB_URL=jdbc:postgresql://localhost:5432/smartbuild_db
DB_USERNAME=smartbuild
# NO default — must be supplied
DB_PASSWORD=change-me

# Hibernate schema mode: update | none | validate | create | create-drop
DB_DDL_AUTO=update

# HTTP port
SERVER_PORT=8080

# Comma-separated list of allowed frontend origins (never *)
CORS_ALLOWED_ORIGINS=http://localhost:5173
