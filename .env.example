# ---------------------------------------------------------------------------
# SmartBuild India — Base-v1 environment template
#
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is git-ignored. NEVER commit real credentials.
#
# Only the backend actually reads these variables. The frontend reads
# VITE_API_BASE_URL from frontend/.env (see frontend/.env.example).
# ---------------------------------------------------------------------------

# --- Backend (Spring Boot) -------------------------------------------------
# Full JDBC URL of the PostgreSQL database.
DB_URL=jdbc:postgresql://localhost:5432/smartbuild_db

# Database role used by the application.
DB_USERNAME=smartbuild

# REQUIRED — there is no default password. Set your own local password here.
DB_PASSWORD=change-me

# How Hibernate manages the schema in development.
#   update  = create/alter tables from the entities (default, used by Base-v1)
#   validate = only check the schema matches (use once migrations exist)
DB_DDL_AUTO=update

# Port the Spring Boot server listens on.
SERVER_PORT=8080

# Comma-separated list of browser origins allowed to call the API.
# Never use a wildcard in anything shared beyond local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173
